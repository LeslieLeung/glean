{
  "manifest_version": 3,
  "name": "Glean",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.7",
  "default_locale": "en",
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Glean",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
